---
import Profile from './Profile.astro';
import Icon from './Icon.astro';
import {
  copy,
  papers,
  education,
  skills,
  secondaryEmails,
  type Locale,
} from '../data/site';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<main class="home" id="top">
  <div class="hero-notes" aria-hidden="true">
    <span>PERSONAL INDEX / 01</span>
    <span>RESEARCH × CODE</span>
  </div>
  <a class="scroll-cue" href="#content">
    <span>{t.scroll}</span>
    <Icon name="down" size={16} />
  </a>
  <div class="home-grid">
    <Profile locale={locale} />
    <div class="content-column">
      <section
        class="intro-section section"
        id="content"
        tabindex="-1"
        aria-labelledby="intro-heading"
      >
        <p class="eyebrow section-kicker">
          <span class="section-number">01</span>
          {t.introLabel}
        </p>
        <h2 class="intro-title" id="intro-heading">
          {t.introTitle}
        </h2>
        <p class="intro-lead">{t.intro}</p>
        <p>{t.introMore}</p>
        <div class="intro-signoff">
          <span class="fine-rule"></span>
          <Icon name="spark" size={22} />
          <span class="mono">learning, one experiment at a time.</span>
        </div>
      </section>
      <section
        class="section"
        id="education"
        aria-labelledby="education-heading"
      >
        <div class="section-heading">
          <span class="section-number">02</span>
          <div>
            <h2 id="education-heading">{t.education}</h2>
            <p>{t.educationNote}</p>
          </div>
        </div>
        <div class="education-list">
          {education.map((item, i) => (
            <article class="education-entry">
              <div class="education-track">
                <span
                  class:list={['timeline-dot', { current: i === 0 }]}
                ></span>
              </div>
              <div>
                <p class="education-period">{item.period}</p>
                <h3>{item[locale].school}</h3>
                <p class="education-degree">{item[locale].degree}</p>
                <p class="education-detail">{item[locale].detail}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="section" id="research" aria-labelledby="research-heading">
        <div class="section-heading">
          <span class="section-number">03</span>
          <div>
            <h2 id="research-heading">{t.research}</h2>
            <p>{t.researchNote}</p>
          </div>
        </div>
        <div class="interests">
          {t.interests.map((interest, i) => (
            <article class="interest">
              <span class="interest-index">0{i + 1}</span>
              <div>
                <h3>{interest.title}</h3>
                <p>{interest.text}</p>
              </div>
              <span class="interest-symbol" aria-hidden="true">
                {['↗', '⇌', '✳'][i]}
              </span>
            </article>
          ))}
        </div>
      </section>
      <section
        class="section"
        id="publications"
        aria-labelledby="papers-heading"
      >
        <div class="section-heading">
          <span class="section-number">04</span>
          <div>
            <h2 id="papers-heading">{t.papers}</h2>
            <p>{t.papersNote}</p>
          </div>
        </div>
        <div class="papers">
          {papers.map((paper, i) => (
            <article class="paper">
              <div class="paper-meta">
                <span class:list={['paper-status', paper.kind]}>
                  {paper.status[locale]}
                </span>
                <span class="paper-number">
                  /{String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3>
                <a href={paper.url} target="_blank" rel="noopener noreferrer">
                  {paper.title}
                  <Icon name="arrow" size={18} />
                </a>
              </h3>
              <p class="paper-venue">{paper.venue}</p>
              <p class="paper-summary">{paper.summary[locale]}</p>
              <a
                class="text-link"
                href={paper.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.paperLink}
                <Icon name="arrow" size={14} />
              </a>
            </article>
          ))}
        </div>
      </section>
      <section class="section" id="toolkit" aria-labelledby="skills-heading">
        <div class="section-heading">
          <span class="section-number">05</span>
          <div>
            <h2 id="skills-heading">{t.skills}</h2>
            <p>{t.skillsNote}</p>
          </div>
        </div>
        <div class="skill-groups">
          {skills.map((group, i) => (
            <div class="skill-group">
              <h3>
                <span class="prompt" aria-hidden="true">
                  ❯
                </span>
                {t.skillGroups[i]}
              </h3>
              <ul>
                {group.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      <section class="section awards-section" aria-labelledby="awards-heading">
        <div class="section-heading">
          <span class="section-number">06</span>
          <div>
            <h2 id="awards-heading">{t.awards}</h2>
          </div>
        </div>
        <ul class="awards-list">
          {t.awardItems.map((item) => (
            <li>
              <Icon name="spark" size={17} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="contact-section" aria-labelledby="contact-heading">
        <p class="eyebrow">{t.elsewhere}</p>
        <h2 id="contact-heading">{t.contact}</h2>
        <p>{t.contactText}</p>
        <a class="contact-link" href="mailto:yl1118@exeter.ac.uk">
          yl1118@exeter.ac.uk
          <Icon name="arrow" size={22} />
        </a>
        <div class="secondary-emails">
          <p class="eyebrow" id="secondary-email-label">
            {t.secondaryEmails}
          </p>
          <ul aria-labelledby="secondary-email-label">
            {secondaryEmails.map((email) => (
              <li>
                <a class="text-link" href={`mailto:${email}`}>
                  {email}
                  <Icon name="arrow" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </div>
</main>
