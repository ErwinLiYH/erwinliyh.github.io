---
import Layout from '../layouts/Layout.astro';
import CodeBlock from './CodeBlock.astro';
import {
  devCopy,
  devSections,
  devPath,
  piSetups,
  installCommand,
  grillingSkills,
  systemPrompt,
  type DevSection,
} from '../data/dev';
import type { Locale } from '../data/site';
import DirectorySidebar from './DirectorySidebar.astro';
import TerminalPath from './TerminalPath.astro';
interface Props {
  locale: Locale;
  section?: DevSection;
}
const { locale, section = 'pi' } = Astro.props;
const t = devCopy[locale];
const title = t.pages[section];
const description = t.descriptions[section];
---

<Layout
  locale={locale}
  page="dev"
  subpage={section === 'pi' ? '' : `${section}/`}
  title={`${title} · Dev`}
  description={description}
>
  <main class="dev-layout" id="top">
    <DirectorySidebar
      directory="dev"
      group="AI agent"
      label={t.directory}
      menu={t.menu}
      title={title}
      items={devSections.map((item) => ({
        href: devPath(locale, item),
        label: t.pages[item],
        current: section === item ? 'page' : undefined,
      }))}
    />
    <article class="dev-article" id="content" tabindex="-1">
      <header class="dev-page-header">
        <TerminalPath path="dev/AI agent" />
        <h1>
          {title}
          <span class="name-dot">.</span>
        </h1>
        {section === 'pi' && (
          <div
            class="pi-switch"
            role="radiogroup"
            aria-label={locale === 'zh' ? 'Pi 使用环境' : 'Use Pi in'}
          >
            {piSetups.map(({ id, label }) => (
              <label>
                <input
                  type="radio"
                  name="pi-environment"
                  value={id}
                  aria-controls={`setup-${id}`}
                  checked={id === 'terminal'}
                />
                <span>{label}</span>
              </label>
            ))}
          </div>
        )}
        <p class="dev-lead">{description}</p>
      </header>
      {section === 'pi' && (
        <>
          {piSetups.map(({ id, groups }) => (
            <div id={`setup-${id}`}>
              {id === 't3-code' && (
                <section class="dev-section dev-t3-intro">
                  <h2>
                    {locale === 'zh'
                      ? '在 T3 Code 中使用 Pi'
                      : 'Using Pi in T3 Code'}
                  </h2>
                  <p>
                    <a href="https://t3.codes">T3 Code</a>
                    {locale === 'zh'
                      ? ' 是一款用于管理编程 Agent 的开源桌面应用。你可以从自己的电脑连接远程开发环境，使用运行在远程主机上的 Pi。多个 Agent 同时工作时，你可以在同一界面查看各自的进度，并切换到需要你回应的会话。'
                      : ' is an open-source desktop app for managing coding agents. Connect to a remote development environment to use Pi on that host. When several agents are running, you can check each agent’s progress in one place and switch to the session that needs your input.'}
                  </p>
                  <p>
                    {locale === 'zh'
                      ? 'T3 Code 为 Pi 提供了额外的工具，例如 Pi 可以直接把任务交给子代理，无需再安装 pi-subagents 插件。'
                      : 'T3 Code gives Pi extra tools so you can skip some plugins: for example, Pi can delegate tasks to subagents without the pi-subagents plugin.'}
                  </p>
                  <p>
                    {locale === 'zh' ? '前往' : 'Visit the '}
                    <a href="https://t3.codes/download">
                      {locale === 'zh'
                        ? '官方下载页'
                        : 'official download page'}
                    </a>
                    {locale === 'zh'
                      ? '，选择适合你操作系统的版本。'
                      : ' to get the version for your operating system.'}
                  </p>
                </section>
              )}
              <section
                class="dev-section"
                id={id === 'terminal' ? 'install' : 't3-install'}
              >
                <h2>
                  <span class="dev-index">00</span>
                  {t.install}
                </h2>
                <p>{t.installNote}</p>
                <div class="dev-source-links">
                  <a
                    href="https://pi.dev"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t.website} ↗
                  </a>
                  <a
                    href="https://github.com/earendil-works/pi"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t.repo} ↗
                  </a>
                </div>
                <CodeBlock
                  locale={locale}
                  label="macOS / Linux"
                  code="curl -fsSL https://pi.dev/install.sh | sh"
                />
              </section>
              <nav
                class="dev-jump-links"
                aria-label={locale === 'zh' ? '插件分组' : 'Plugin groups'}
              >
                {groups.map((group) => (
                  <a href={`#${group.id}`}>
                    {group.title} <span aria-hidden="true">↓</span>
                  </a>
                ))}
              </nav>
              {groups.map((group, index) => (
                <section class="dev-section" id={group.id}>
                  <h2>
                    <span class="dev-index">0{index + 1}</span>
                    {group.title}
                  </h2>
                  <p>{group.description[locale]}</p>
                  <ul class="dev-resource-list">
                    {group.plugins.map((plugin) => (
                      <li>
                        <h3>{plugin.name}</h3>
                        <p>{plugin.description[locale]}</p>
                        <div class="dev-source-links">
                          <a
                            href={`https://www.npmjs.com/package/${plugin.package}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${plugin.name} · ${t.package}`}
                          >
                            {t.package} ↗
                          </a>
                          <a
                            href={plugin.repo}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${plugin.name} · ${t.repo}`}
                          >
                            {t.repo} ↗
                          </a>
                        </div>
                      </li>
                    ))}
                  </ul>
                  <CodeBlock
                    locale={locale}
                    label={`${t.installGroup} · ${group.title}`}
                    code={installCommand(group.plugins)}
                  />
                </section>
              ))}
            </div>
          ))}
        </>
      )}
      {section === 'system-prompt' && (
        <section class="dev-section dev-prompt-section">
          <p>{t.promptContext}</p>
          <p>{t.subagentRationale}</p>
          <div class="dev-source-links">
            <a
              href="https://arxiv.org/abs/2512.08296v3"
              target="_blank"
              rel="noopener noreferrer"
            >
              Kim et al. · Towards a Science of Scaling Agent Systems ↗
            </a>
          </div>
          <CodeBlock
            locale={locale}
            label={t.promptPath}
            code="~/.pi/agent/APPEND_SYSTEM.md"
          />
          <p>{t.promptUsage}</p>
          <CodeBlock
            locale={locale}
            label="APPEND_SYSTEM.md"
            code={systemPrompt[locale]}
            wrap
          />
        </section>
      )}
      {section === 'skills' && (
        <>
          <p class="dev-note">{t.skillsNote}</p>
          <section class="dev-section" id="grilling">
            <h2>
              <span class="dev-index">01</span>Grilling & domain modeling
            </h2>
            <p>{t.grillingIntro}</p>
            <div class="dev-source-links">
              <a
                href="https://github.com/mattpocock/skills"
                target="_blank"
                rel="noopener noreferrer"
              >
                mattpocock/skills ↗
              </a>
            </div>
            <ul class="dev-resource-list">
              {grillingSkills.map((skill) => (
                <li>
                  <h3>
                    <a
                      href={`https://github.com/mattpocock/skills/tree/main/skills/${skill.category}/${skill.name}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {skill.name}{' '}
                      <span class="dev-inline-arrow" aria-hidden="true">
                        ↗
                      </span>
                    </a>
                  </h3>
                  <p>{skill.description[locale]}</p>
                </li>
              ))}
            </ul>
          </section>
          <section class="dev-section" id="nature-skills">
            <h2>
              <span class="dev-index">02</span>Nature Skills
            </h2>
            <p>{t.natureIntro}</p>
            <p>{t.natureNote}</p>
            <div class="dev-source-links">
              <a
                href="https://github.com/yuan1z0825/nature-skills"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.repo} ↗
              </a>
              <a
                href="https://yuan1z0825.github.io/nature-skills/"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.website} ↗
              </a>
            </div>
          </section>
        </>
      )}
      {section === 'custom-skills' && (
        <section class="dev-placeholder">
          <span class="mono dev-placeholder-mark" aria-hidden="true">
            [ … ]
          </span>
          <h2>{t.later}</h2>
          <p>{t.laterText}</p>
        </section>
      )}
    </article>
  </main>
</Layout>
