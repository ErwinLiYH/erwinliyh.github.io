---
import Layout from '../../layouts/Layout.astro';
import DirectorySidebar from '../../components/DirectorySidebar.astro';
import TerminalPath from '../../components/TerminalPath.astro';
import { base, locales, copy, pathFor, type Locale } from '../../data/site';
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    ['vibe-coding'].map((page) => ({ params: { locale, page } })),
  );
}
const locale = Astro.params.locale as Locale;
const page = 'vibe-coding';
const t = copy[locale];
const title = t.vibeTitle;
const description = t.vibeDescription;
---

<Layout locale={locale} page={page} title={t[page]} description={description}>
  <main class="dev-layout" id="top">
    <DirectorySidebar
      directory={page}
      group={locale === 'zh' ? '项目' : 'Projects'}
      label={locale === 'zh' ? '项目目录' : 'Project directory'}
      menu={locale === 'zh' ? '项目导航' : 'Project navigation'}
      title="remote-copy (ry)"
      items={[
        {
          href: '#remote-copy',
          label: 'remote-copy (ry)',
          current: 'location',
        },
      ]}
    />
    <div class="collection-page" id="content" tabindex="-1">
      <TerminalPath path={page} />
      <h1>{title}</h1>
      <article class="vibe-project" id="remote-copy" tabindex="-1">
        <div>
          <h2>remote-copy <span class="mono">(ry)</span></h2>
          <p>{t.remoteCopyIntro}</p>
          <a class="text-link" href="https://github.com/ErwinLiYH/remote-copy">
            {t.remoteCopyRepo} ↗
          </a>
        </div>
        <a href={`${base}/images/remote-copy/transfer-topology.png`}>
          <img
            src={`${base}/images/remote-copy/transfer-topology.png`}
            width="1586"
            height="992"
            alt={t.remoteCopyTopology}
          />
        </a>
      </article>
      <a class="text-link return-link" href={pathFor(locale)}>
        <span aria-hidden="true">←</span>
        {t.returnHome}
      </a>
    </div>
  </main>
</Layout>
