---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import { base } from '../data/site';
---

<Layout locale="en">
  <script is:inline define:vars={{ base }}>
    let locale = 'en';
    try {
      if (localStorage.getItem('preferred-language') === 'zh') locale = 'zh';
    } catch {}
    location.replace(`${base}/${locale}/${location.search}${location.hash}`);
  </script>
  <About locale="en" />
</Layout>
